# One report daily at 00:05; the 1st also sends mail when healthy.
# Keep these schedules non-overlapping to avoid duplicate scans and alerts.
CRON_SCHEDULE='5 0 2-31 * *'
HEALTHY_CRON_SCHEDULE='5 0 1 * *'
TZ=Etc/UTC

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Optional for temporary AWS credentials:
AWS_SESSION_TOKEN=

# Set both for authenticated SMTP, or leave both empty for a relay.
SMTP_USERNAME=
SMTP_PASSWORD=

# Endpoint, repositories, sender, and recipients belong in config.toml.
# Single-quote values containing $ or # to prevent Compose interpolation.
